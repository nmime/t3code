[Unit]
Description=t3x control plane (T3 Code + OpenSandbox task sandboxes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=t3x
Group=t3x
WorkingDirectory=/opt/t3code
EnvironmentFile=/etc/t3x/env
# --worker-url must be an address a sandbox can dial; --worker-bundle ships the worker into each sandbox
ExecStart=/usr/bin/node /opt/t3code/packages/daytona/dist/src/cli.js serve --state-dir /var/lib/t3x --port 8087 --worker-url https://control-plane.example.com --worker-bundle /var/lib/t3x/worker.tgz
Restart=always
RestartSec=2

# The control plane needs to reach the sandbox lifecycle server (and, through
# it, the sandboxes it creates) and nothing else. Credentials live in
# /etc/t3x/env (0600, owner t3x).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/t3x

[Install]
WantedBy=multi-user.target
